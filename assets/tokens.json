{
  "$schema": "https://design-tokens.org/schema",
  "name": "BrainChain Orchestrator Design System",
  "version": "1.0.0",
  "color": {
    "background": {
      "primary":   { "value": "#1a1a1a", "rgb": "26, 26, 26",   "hsl": "0, 0%, 10.2%",  "alias": "bg-primary",   "usage": "App canvas, IDE body" },
      "secondary": { "value": "#242424", "rgb": "36, 36, 36",   "hsl": "0, 0%, 14.1%",  "alias": "bg-secondary", "usage": "Tab bars, sidebars, modals" },
      "tertiary":  { "value": "#2d2d2d", "rgb": "45, 45, 45",   "hsl": "0, 0%, 17.6%",  "alias": "bg-tertiary",  "usage": "Inputs, buttons (hover), chips" },
      "elevated":  { "value": "#353535", "rgb": "53, 53, 53",   "hsl": "0, 0%, 20.8%",  "alias": "bg-elevated",  "usage": "Cards, popovers, dropdowns" },
      "void":      { "value": "#0a0a0a", "rgb": "10, 10, 10",   "hsl": "0, 0%, 3.9%",   "alias": "bg-void",      "usage": "Terminal/editor canvas, deep recess" }
    },
    "text": {
      "primary":   { "value": "#ffffff", "rgb": "255,255,255",  "hsl": "0, 0%, 100%",   "alias": "text-primary",   "usage": "Headings, primary text" },
      "secondary": { "value": "#b0b0b0", "rgb": "176,176,176",  "hsl": "0, 0%, 69%",    "alias": "text-secondary", "usage": "Body text, descriptions" },
      "tertiary":  { "value": "#808080", "rgb": "128,128,128",  "hsl": "0, 0%, 50.2%",  "alias": "text-tertiary",  "usage": "Captions, meta, labels" },
      "muted":     { "value": "#606060", "rgb": "96, 96, 96",   "hsl": "0, 0%, 37.6%",  "alias": "text-muted",     "usage": "Disabled, placeholders" }
    },
    "accent": {
      "purple":       { "value": "#7c3aed", "rgb": "124, 58, 237",  "hsl": "262.1, 83.3%, 57.8%", "alias": "accent",       "usage": "Primary CTAs, focus rings, links" },
      "purple-light": { "value": "#a78bfa", "rgb": "167, 139, 250", "hsl": "258.3, 89.5%, 76.3%", "alias": "accent-light", "usage": "Hover states, secondary accent" },
      "purple-dark":  { "value": "#6d28d9", "rgb": "109, 40, 217",  "hsl": "262.3, 69.4%, 50.4%", "alias": "accent-dark",  "usage": "Active/pressed state of primary" }
    },
    "status": {
      "success": { "value": "#10b981", "rgb": "16, 185, 129",  "hsl": "159.8, 84.1%, 39.4%", "alias": "success", "usage": "OK/connected, terminal output type indicator" },
      "warning": { "value": "#f59e0b", "rgb": "245, 158, 11",  "hsl": "37.7, 92.1%, 50.2%",  "alias": "warning", "usage": "Custos, alertas, estrelas" },
      "error":   { "value": "#ef4444", "rgb": "239, 68, 68",   "hsl": "0, 84.2%, 60.4%",     "alias": "error",   "usage": "Erro, fechar destrutivo, dot live" },
      "info":    { "value": "#3b82f6", "rgb": "59, 130, 246",  "hsl": "217.2, 91.2%, 59.8%", "alias": "info",    "usage": "Em andamento, GitHub provider" }
    },
    "border": {
      "default": { "value": "#3d3d3d", "rgb": "61, 61, 61",   "hsl": "0, 0%, 23.9%",  "alias": "border-c",    "usage": "Hover-state borders, dividers fortes" },
      "soft":    { "value": "#2a2a2a", "rgb": "42, 42, 42",   "hsl": "0, 0%, 16.5%",  "alias": "border-soft", "usage": "Bordas padrão, divisores sutis" },
      "accent":  { "value": "#7c3aed", "rgb": "124, 58, 237", "hsl": "262.1, 83.3%, 57.8%", "alias": "border-accent", "usage": "Focado, selecionado" }
    },
    "agent": {
      "claude":  { "value": "#c2410c", "rgb": "194, 65, 12",  "hsl": "20.5, 88.7%, 40.4%",  "usage": "Anthropic Claude · header, badges, avatares" },
      "codex":   { "value": "#0d9488", "rgb": "13, 148, 136", "hsl": "175.3, 84%, 31.6%",   "usage": "OpenAI Codex/GPT" },
      "gemini":  { "value": "#3b82f6", "rgb": "59, 130, 246", "hsl": "217.2, 91.2%, 59.8%", "usage": "Google Gemini" },
      "mistral": { "value": "#eab308", "rgb": "234, 179, 8",  "hsl": "45.4, 93.4%, 47.5%",  "usage": "Mistral AI" },
      "llama":   { "value": "#a78bfa", "rgb": "167, 139, 250","hsl": "258.3, 89.5%, 76.3%", "usage": "Meta Llama" },
      "deepseek":{ "value": "#06b6d4", "rgb": "6, 182, 212",  "hsl": "188.7, 94.5%, 42.7%", "usage": "DeepSeek" },
      "qwen":    { "value": "#dc2626", "rgb": "220, 38, 38",  "hsl": "0, 72.2%, 50.6%",     "usage": "Alibaba Qwen" },
      "cohere":  { "value": "#0ea5e9", "rgb": "14, 165, 233", "hsl": "198.6, 88.7%, 48.4%", "usage": "Cohere" }
    },
    "pane-kind": {
      "agent":    { "value": "varies", "usage": "Borda topo do header recebe a cor do agente em opacidade 22 (hex) e o badge a cor cheia" },
      "terminal": { "value": "#10b981", "usage": "Header chip + cursor; sucesso e prompt $ em success" },
      "browser":  { "value": "#3b82f6", "usage": "Header chip + lock icon (live)" },
      "editor":   { "value": "#a78bfa", "usage": "Header chip + linha de gutter ativa" }
    }
  },
  "typography": {
    "family": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "weight": {
      "regular":  400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },
    "size": {
      "9":  { "value": "9px",  "rem": "0.5625rem", "usage": "Labels uppercase, badges minúsculos" },
      "10": { "value": "10px", "rem": "0.625rem",  "usage": "Status pills, kbd, footnotes" },
      "11": { "value": "11px", "rem": "0.6875rem", "usage": "Filtros, metadata em listas" },
      "12": { "value": "12px", "rem": "0.75rem",   "usage": "Body padrão de listas, descriptions" },
      "13": { "value": "13px", "rem": "0.8125rem", "usage": "Body de cards, labels de form" },
      "14": { "value": "14px", "rem": "0.875rem",  "usage": "Body padrão de modais, botões" },
      "15": { "value": "15px", "rem": "0.9375rem", "usage": "Card title, list section heading" },
      "16": { "value": "16px", "rem": "1rem",      "usage": "H3, top-bar title, body de prose" },
      "18": { "value": "18px", "rem": "1.125rem",  "usage": "Heading médio" },
      "20": { "value": "20px", "rem": "1.25rem",   "usage": "Heading wizard" },
      "24": { "value": "24px", "rem": "1.5rem",    "usage": "Heading large, stat number" },
      "26": { "value": "26px", "rem": "1.625rem",  "usage": "Login subtítulo, metric value" },
      "28": { "value": "28px", "rem": "1.75rem",   "usage": "Page heading" },
      "40": { "value": "40px", "rem": "2.5rem",    "usage": "Hero heading (login)" },
      "44": { "value": "44px", "rem": "2.75rem",   "usage": "Hero heading XL" }
    },
    "lineHeight": {
      "tight":   1.05,
      "snug":    1.25,
      "normal":  1.5,
      "relaxed": 1.65,
      "loose":   1.8
    },
    "letterSpacing": {
      "tight":  "-0.02em",
      "normal": "0",
      "wide":   "0.04em",
      "wider":  "0.14em",
      "widest": "0.18em"
    }
  },
  "spacing": {
    "0":  { "value": "0px"  },
    "0.5":{ "value": "2px"  },
    "1":  { "value": "4px"  },
    "1.5":{ "value": "6px"  },
    "2":  { "value": "8px"  },
    "2.5":{ "value": "10px" },
    "3":  { "value": "12px" },
    "3.5":{ "value": "14px" },
    "4":  { "value": "16px" },
    "5":  { "value": "20px" },
    "6":  { "value": "24px" },
    "7":  { "value": "28px" },
    "8":  { "value": "32px" },
    "9":  { "value": "36px" },
    "10": { "value": "40px" },
    "12": { "value": "48px" },
    "14": { "value": "56px" },
    "16": { "value": "64px" },
    "20": { "value": "80px" }
  },
  "radius": {
    "none":  "0px",
    "sm":    "4px",
    "md":    "6px",
    "lg":    "8px",
    "xl":    "12px",
    "2xl":   "16px",
    "full":  "9999px"
  },
  "shadow": {
    "sm":  "0 1px 2px rgba(0, 0, 0, 0.05)",
    "md":  "0 4px 6px rgba(0, 0, 0, 0.25)",
    "lg":  "0 10px 15px rgba(0, 0, 0, 0.35)",
    "xl":  "0 20px 25px rgba(0, 0, 0, 0.45)",
    "accent-glow":   "0 6px 18px rgba(124, 58, 237, 0.45)",
    "primary-press": "0 10px 24px rgba(124, 58, 237, 0.45)",
    "focus-ring":    "0 0 0 3px rgba(124, 58, 237, 0.18)"
  },
  "duration": {
    "instant": "0ms",
    "fast":    "120ms",
    "normal":  "150ms",
    "slow":    "200ms",
    "slower":  "300ms",
    "loader":  "1000ms",
    "pulse":   "2000ms"
  },
  "easing": {
    "linear":    "linear",
    "ease":      "ease",
    "ease-in":   "cubic-bezier(0.4, 0, 1, 1)",
    "ease-out":  "cubic-bezier(0, 0, 0.2, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "z-index": {
    "base":       0,
    "raised":     1,
    "dropdown":   30,
    "drag-overlay": 40,
    "modal":      50,
    "modal-content": 51,
    "picker-fab": 60,
    "floating-window-base": 100,
    "tooltip":    200
  },
  "breakpoint": {
    "sm":  "640px",
    "md":  "768px",
    "lg":  "1024px",
    "xl":  "1280px",
    "2xl": "1536px"
  },
  "size": {
    "header-height":      "56px",
    "topbar-window":      "28px",
    "topbar-tab":         "44px",
    "topbar-prompt":      "44px",
    "statusbar-height":   "24px",
    "wizard-footer":      "64px",
    "sidebar-files":      "240px",
    "sidebar-nav":        "240px",
    "settings-modal":     "680px",
    "wizard-modal-max":   "760px",
    "pane-min-width":     "240px",
    "pane-min-height":    "160px",
    "detach-min-width":   "280px",
    "detach-min-height":  "180px",
    "container-max":      "1280px",
    "avatar-sm":          "24px",
    "avatar-md":          "32px",
    "avatar-lg":          "40px",
    "avatar-xl":          "80px",
    "icon-xs":            "10px",
    "icon-sm":            "12px",
    "icon-md":            "14px",
    "icon-lg":            "16px",
    "icon-xl":            "20px",
    "icon-2xl":           "24px"
  }
}
